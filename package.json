{
  "name": "gasweek",
  "version": "0.1.0",
  "description": "when is ethereum cheapest? base fee by hour of day over the last week, in the browser or node. zero dependencies, public rpc, no keys.",
  "keywords": ["ethereum", "gas", "base fee", "eip-1559", "eth_feeHistory", "json-rpc"],
  "homepage": "https://github.com/alinaschanz/gasweek-js#readme",
  "bugs": "https://github.com/alinaschanz/gasweek-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alinaschanz/gasweek-js.git"
  },
  "license": "MIT",
  "author": "Alina Schanz <hello@alinaschanz.life> (https://alinaschanz.life)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/stats.test.js dist/test/fees.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
